# Local dev (outside Docker). docker-compose overrides this for the api container.
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
COLLECTION_NAME=simple_rag

OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

LLM_MODEL=qwen3:4b

# Conversation memory: "memory" (lost on restart) or "postgres" (docker-compose uses postgres).
CHECKPOINTER=memory
MAX_REWRITES=2
HISTORY_TURNS=6
